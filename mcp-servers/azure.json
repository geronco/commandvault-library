{
  "name": "Azure MCP server (Microsoft)",
  "description": "Work with Azure resources such as Storage, Cosmos DB, Key Vault, Monitor and AKS from one Microsoft-maintained server.",
  "homepage": "https://learn.microsoft.com/azure/developer/azure-mcp-server/",
  "repository": "https://github.com/microsoft/mcp",
  "mcpServers": {
    "azure": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "env": {
        "AZURE_TENANT_ID": "YOUR_AZURE_TENANT_ID",
        "AZURE_CLIENT_ID": "YOUR_AZURE_CLIENT_ID",
        "AZURE_CLIENT_SECRET": "YOUR_AZURE_CLIENT_SECRET"
      }
    }
  }
}
