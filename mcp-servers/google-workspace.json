{
  "name": "Google Workspace MCP (community)",
  "description": "Gmail, Drive, Docs, Sheets, Calendar, Slides, Forms, Chat and Tasks in one OAuth server, with tool tiers and read-only mode.",
  "homepage": "https://workspacemcp.com",
  "repository": "https://github.com/taylorwilsdon/google_workspace_mcp",
  "mcpServers": {
    "google-workspace": {
      "command": "uvx",
      "args": [
        "workspace-mcp",
        "--tool-tier",
        "core"
      ],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "YOUR_GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET": "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
      }
    }
  }
}
