{
  "name": "Firecrawl MCP server (official)",
  "description": "Scrape, crawl, map, search and extract structured data from websites as clean markdown.",
  "homepage": "https://docs.firecrawl.dev/mcp-server",
  "repository": "https://github.com/firecrawl/firecrawl-mcp-server",
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "YOUR_FIRECRAWL_API_KEY",
        "FIRECRAWL_API_URL": "YOUR_FIRECRAWL_API_URL"
      }
    }
  }
}
